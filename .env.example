# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Shown in WhatsApp messages to customers
NEXT_PUBLIC_COMPANY_NAME=Your Company Sdn Bhd

# WhatsApp Cloud API (server only — never NEXT_PUBLIC). Sends "delivered" + POD photo from the
# company number. Leave empty to keep only the drivers' own WhatsApp buttons. See README.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_DELIVERED=delivered_photo
# Optional: template without the image header, for deliveries with no photo.
WHATSAPP_TEMPLATE_DELIVERED_NO_PHOTO=
WHATSAPP_TEMPLATE_LANG=en

# Google Maps (server only — never NEXT_PUBLIC). Enable "Geocoding API" and "Routes API".
# Used to measure store → customer driving distance for driver points.

# AutoCount API by IPS (server only — never NEXT_PUBLIC). READ ONLY: the app only calls login + /select.
# Test with: npm run autocount:check
AUTOCOUNT_API_URL=
AUTOCOUNT_DB_NAME=AED_YOURCOMPANY
AUTOCOUNT_USER=your-autocount-user
AUTOCOUNT_PASSWORD=your-autocount-password
# Only if IPS gave you Cloudflare Access keys; otherwise leave empty.
# AUTOCOUNT_CF_ACCESS_CLIENT_ID=
# AUTOCOUNT_CF_ACCESS_CLIENT_SECRET=

# Supabase staff user the AutoCount sync signs in as (see supabase/sync-user.sql)
SUPABASE_SYNC_EMAIL=autocount-sync@khdelivery.my
SUPABASE_SYNC_PASSWORD=PASSWORD